---
import DownloadButton from '../components/DownloadButton.astro';
import { art, path } from '../site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  home?: boolean;
}

const { title, description, home = false } = Astro.props;
const about = path('acerca-de/');
const mainLinks = [
  { label: 'La app', href: path('') + '#experiencia' },
  ...(home ? [{ label: 'Preguntas', href: '#preguntas' }] : []),
  { label: 'Acerca de', href: about },
];
---
<!doctype html>
<html lang="es-HN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={home ? '#091429' : '#f7f9fc'} />
    <link rel="icon" type="image/webp" href={art('icon.webp')} />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-10 focus:rounded-xl focus:bg-white focus:p-3 focus:text-navy" href="#contenido">Ir al contenido</a>
    <header class:list={['border-b', home ? 'border-white/10 bg-night text-white' : 'border-line bg-canvas']}>
      <div class="shell relative flex min-h-16 items-center justify-between gap-5 sm:min-h-20">
        <a href={path('')} aria-label="TicketHN, inicio" class="shrink-0">
          <img src={art(home ? 'tickethn_wordmark_dark.png' : 'tickethn_wordmark_light.png')} width="2491" height="512" alt="" class="h-auto w-29 sm:w-36" />
        </a>
        <nav aria-label="Navegación principal" class="hidden gap-8 text-sm font-medium sm:flex">
          {mainLinks.map(({ label, href }) => (
            <a class="py-2 hover:underline hover:underline-offset-4" href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <div class="hidden sm:block"><DownloadButton compact /></div>
        <details data-mobile-nav class="group sm:hidden">
          <summary class:list={['flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-xl border px-3 text-sm font-semibold [&::-webkit-details-marker]:hidden', home ? 'border-white/25' : 'border-line']}>
            Menú
            <svg class="size-5 group-open:hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8h16M4 16h16" /></svg>
            <svg class="hidden size-5 group-open:block" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
          </summary>
          <nav aria-label="Navegación principal" class:list={['absolute inset-x-5 top-full z-20 mt-2 rounded-2xl border p-3 shadow-lg', home ? 'border-white/15 bg-night' : 'border-line bg-white']}>
            {mainLinks.map(({ label, href }) => (
              <a class:list={['flex min-h-12 items-center rounded-lg px-3 font-medium', home ? 'hover:bg-white/10 aria-[current=page]:bg-white/10' : 'hover:bg-canvas aria-[current=page]:bg-canvas']} href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>
            ))}
            <div class:list={['mt-2 border-t px-3 pt-2', home ? 'border-white/15' : 'border-line']}><DownloadButton compact /></div>
          </nav>
        </details>
      </div>
    </header>
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-line bg-canvas">
      <div class="shell flex flex-col justify-between gap-8 py-10 sm:flex-row sm:items-end">
        <div>
          <a href={path('')} aria-label="TicketHN, inicio" class="inline-block">
            <img src={art('tickethn_wordmark_light.png')} width="2491" height="512" alt="" class="h-auto w-32" />
          </a>
          <p class="mt-3 text-sm text-muted">Proyecto académico del Grupo 3 · UTH</p>
        </div>
        <nav aria-label="Información y políticas" class="flex flex-wrap gap-x-6 gap-y-4 text-sm font-semibold">
          <a class="hover:underline hover:underline-offset-4" href={about}>Acerca de</a>
          <a class="hover:underline hover:underline-offset-4" href={path('privacidad/')}>Privacidad</a>
          <a class="hover:underline hover:underline-offset-4" href={path('eliminar-cuenta/')}>Eliminar cuenta</a>
        </nav>
      </div>
      <div class="shell pb-7 text-xs leading-relaxed text-muted">
        <p>Android is a trademark of Google LLC.</p>
      </div>
    </footer>
  </body>
</html>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]');
  if (menu) {
    const trigger = menu.querySelector('summary');

    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
    });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        trigger?.focus();
      }
    });
  }
</script>
